# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Client-Safe Public Variables Only)
# Project: cits-camp-operations
# NEVER place SUPABASE_SERVICE_ROLE_KEY or sb_secret_ keys in .env or VITE_* variables.
# Configure SUPABASE_SERVICE_ROLE_KEY exclusively in Supabase Edge Function Secrets
# (used server-side by supabase/functions/provision-instructor).
VITE_SUPABASE_URL="https://wdmlxsgbjkboadkeekdq.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# CITS OPERATIONAL DEFAULTS
VITE_DEFAULT_CAMP_DAYS="10"
VITE_DEFAULT_GEOFENCE_METERS="100"
VITE_MAX_SELFIE_KB="300"
VITE_CURRENCY="EGP"

